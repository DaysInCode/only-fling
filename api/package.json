{
  "name": "api",
  "version": "1.0.0",
  "description": ".NET 10 isolated-worker Azure Functions API",
  "private": true,
  "scripts": {
    "build": "dotnet build .\\OnlyFling.Api.csproj",
    "clean": "dotnet clean .\\OnlyFling.Api.csproj",
    "dev": "func start --dotnet-isolated",
    "start": "func start --dotnet-isolated",
    "publish": "dotnet publish .\\OnlyFling.Api.csproj -c Release",
    "test:bdd": "dotnet test .\\tests\\OnlyFling.Api.Bdd\\OnlyFling.Api.Bdd.csproj -c Release",
    "test": "dotnet test ..\\onlyfling-com.sln -c Release"
  },
  "devDependencies": {
    "azure-functions-core-tools": "^4.0.7332"
  }
}
